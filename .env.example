# Serverda: cp .env.example .env && nano .env

# ---------- Admin panel ----------
ADMIN_LOGIN=dilim
ADMIN_PASSWORD=mycoffee2026
# 32+ belgili tasodifiy satr. Yaratish:  openssl rand -base64 48
SESSION_SECRET=

# ---------- Manzil ----------
# Domen ulangan bo'lsa: SITE_ADDRESS=menu.mycoffee.uz  (HTTPS avtomatik olinadi)
# Domen hali yo'q bo'lsa: SITE_ADDRESS=:80              (sayt http://SERVER_IP da ochiladi)
SITE_ADDRESS=:80
# QR kod shu manzilga yo'naltiradi (bo'sh qolsa — admin panel ochilgan manzil olinadi)
NEXT_PUBLIC_SITE_URL=

# ---------- AI tarjima (ixtiyoriy, bepul) ----------
# https://aistudio.google.com/apikey — bo'lmasa bepul Google/MyMemory tarjimasi ishlatiladi.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---------- Ob-havo ----------
# MET Norway User-Agent uchun aloqa (email yoki sayt manzili)
WEATHER_CONTACT=mycoffee-menu admin@mycoffee.uz

# ---------- Ma'lumotlar ombori ----------
# Serverda (Docker) menyu doimiy diskda saqlanadi — bu yerda hech narsa kerak emas.
# Faqat Vercel kabi serversiz hosting uchun: Supabase (supabase/schema.sql).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
