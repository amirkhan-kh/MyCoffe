# ---------- Admin (majburiy, production) ----------
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-strong-password
# 32+ belgili tasodifiy satr:  openssl rand -base64 48
SESSION_SECRET=

# ---------- Sayt manzili (QR kod shu manzilga yo'naltiradi) ----------
NEXT_PUBLIC_SITE_URL=https://menu.mycoffee.uz

# ---------- AI tarjima (ixtiyoriy, bepul) ----------
# https://aistudio.google.com/apikey  — bepul kalit. Bo'lmasa bepul Google/MyMemory tarjimasi ishlatiladi.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---------- Ob-havo ----------
# MET Norway User-Agent uchun aloqa (email yoki sayt manzili)
WEATHER_CONTACT=menu.mycoffee.uz admin@mycoffee.uz

# ---------- Ma'lumotlar ombori ----------
# A) VPS / o'z serveringiz: JSON fayl (standart: ./data)
DATA_DIR=
# B) Vercel kabi serverless: Supabase (bepul tarif yetadi). Ikkalasi ham to'ldirilsa Supabase ishlatiladi.
#    Supabase SQL Editor'da supabase/schema.sql ni bir marta bajaring.
#    Lokal menyuni ko'chirish: npm run db:push
#    Project Settings → API: "Project URL" va "service_role" (secret) kaliti.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
